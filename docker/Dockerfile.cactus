# cactus image, built from source.
#
# cactus needs Go 1.27+ for the built-in crypto/mldsa. The build context
# is the repository root (see compose.yaml).
ARG GO_VERSION=1.27
FROM golang:${GO_VERSION} AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# cactus is pure Go, so build static binaries for the slim runtime image.
RUN CGO_ENABLED=0 go build -o /out/ \
    ./cmd/cactus ./cmd/cactus-cli ./cmd/cactus-keygen

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/cactus /usr/local/bin/cactus
COPY --from=build /out/cactus-cli /usr/local/bin/cactus-cli
COPY --from=build /out/cactus-keygen /usr/local/bin/cactus-keygen

# 14000 ACME, 14080 monitoring/tiles, 14090 metrics.
EXPOSE 14000 14080 14090

ENTRYPOINT ["/usr/local/bin/cactus"]
CMD ["-config", "/etc/cactus/config.json"]
